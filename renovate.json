{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "argocd": {
    "managerFilePatterns": [
      "/^argocd/(apps|bootstrap)/[^/]+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^argocd/apps/workloads/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values\\.ya?ml$/"
    ]
  },
  "terraform": {
    "managerFilePatterns": [
      "/^tofu/.*\\.tf$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Manage RKE2 version in OpenTofu configuration",
      "managerFilePatterns": [
        "/^tofu/variables\\.tf$/"
      ],
      "matchStrings": [
        "(?:#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\n\\s*)?default\\s*=\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+rke2r\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rancher/rke2"
    },
    {
      "customType": "regex",
      "description": "Manage RKE2 version in System Upgrade Controller Plans (same depName so it lands in the same PR as tofu/variables.tf)",
      "managerFilePatterns": [
        "/^argocd/apps/workloads/rke2-upgrade-plans/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+rke2r\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rancher/rke2"
    },
    {
      "customType": "regex",
      "description": "Manage System Upgrade Controller release manifests referenced by Kustomize",
      "managerFilePatterns": [
        "/^argocd/apps/workloads/system-upgrade-controller/kustomization\\.ya?ml$/"
      ],
      "matchStrings": [
        "https://github\\.com/rancher/system-upgrade-controller/releases/download/(?<currentValue>v[^/]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rancher/system-upgrade-controller"
    }
  ],
  "packageRules": [
    {
      "description": "Route Terraform and OpenTofu provider and module lookups to the OpenTofu registry",
      "matchDatasources": [
        "terraform-provider",
        "terraform-module"
      ],
      "registryUrls": [
        "https://registry.opentofu.org"
      ]
    },
    {
      "description": "Custom versioning and labels for RKE2 releases",
      "matchPackageNames": [
        "rancher/rke2"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-?(?<prerelease>.*))?\\+rke2r(?<build>\\d+)$",
      "separateMultipleMinor": true,
      "addLabels": [
        "rke2",
        "opentofu",
        "dependencies"
      ]
    },
    {
      "description": "Longer 7-day cooldown for major version upgrades",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Add labels to Helm chart updates",
      "matchDatasources": [
        "helm"
      ],
      "addLabels": [
        "helm",
        "dependencies"
      ]
    },
    {
      "description": "Add labels to Docker container image updates",
      "matchDatasources": [
        "docker"
      ],
      "addLabels": [
        "docker",
        "dependencies"
      ]
    },
    {
      "description": "Add labels to OpenTofu/Terraform provider and version updates",
      "matchManagers": [
        "terraform"
      ],
      "addLabels": [
        "opentofu",
        "dependencies"
      ]
    },
    {
      "description": "Add labels to GitHub Actions workflow updates",
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "github-actions",
        "ci"
      ]
    }
  ]
}
