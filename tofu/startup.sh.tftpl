#!/usr/bin/env bash
set -euo pipefail

# Mount dedicated /var disk before starting RKE2 or writing logs
VAR_DISK_DEV="/dev/disk/by-id/google-var-disk"

# Wait for attached disk to be detected by kernel/udev
for i in {1..30}; do
  if [ -b "$VAR_DISK_DEV" ]; then
    break
  fi
  sleep 1
done

if [ -b "$VAR_DISK_DEV" ]; then
  # Format as ext4 if not already formatted
  if ! blkid "$VAR_DISK_DEV" | grep -q 'TYPE='; then
    echo "Formatting $VAR_DISK_DEV as ext4..."
    mkfs.ext4 -m 0 -F "$VAR_DISK_DEV"
  fi

  # Mount /var if not already mounted
  if ! findmnt -M /var | grep -q "$VAR_DISK_DEV"; then
    echo "Configuring dedicated /var disk mount..."
    mkdir -p /mnt/var_disk_init
    mount "$VAR_DISK_DEV" /mnt/var_disk_init

    # If new disk is empty (or only lost+found), copy base OS /var contents
    if [ -z "$(ls -A /mnt/var_disk_init 2>/dev/null)" ] || [ "$(ls -A /mnt/var_disk_init 2>/dev/null)" = "lost+found" ]; then
      echo "Copying base OS /var contents to dedicated disk..."
      cp -a /var/. /mnt/var_disk_init/
    fi

    umount /mnt/var_disk_init
    rmdir /mnt/var_disk_init

    # Persist mount in /etc/fstab using UUID
    DISK_UUID=$(blkid -s UUID -o value "$VAR_DISK_DEV")
    if ! grep -q "UUID=$DISK_UUID" /etc/fstab; then
      echo "UUID=$DISK_UUID /var ext4 defaults,nofail 0 2" >> /etc/fstab
    fi

    systemctl daemon-reload
    mount /var
  fi
fi

# Route stdout and stderr to both a bootstrap log file and the console
exec > >(tee -a /var/log/rke2-bootstrap.log /dev/kmsg) 2>&1

echo "============================================================"
echo "Starting RKE2 automated bootstrap on $(hostname)"
echo "Timestamp: $(date -u '+%Y-%m-%d %H:%M:%SZ')"
echo "Node Name: ${node_name}"
echo "Node IP:   ${node_ip}"
echo "============================================================"

# Ensure RKE2 configuration directory exists
mkdir -p /etc/rancher/rke2

%{ if is_init_node ~}
echo "[INIT] Configuring primary RKE2 server node..."

# Configure dedicated /shared disk and NFS server export on primary node
SHARED_DISK_DEV="/dev/disk/by-id/google-shared-disk"
for i in {1..30}; do
  if [ -b "$SHARED_DISK_DEV" ]; then
    break
  fi
  sleep 1
done

if [ -b "$SHARED_DISK_DEV" ]; then
  echo "[SHARED] Setting up dedicated /shared disk on $SHARED_DISK_DEV..."
  if ! blkid "$SHARED_DISK_DEV" | grep -q 'TYPE='; then
    echo "[SHARED] Formatting $SHARED_DISK_DEV as ext4..."
    mkfs.ext4 -m 0 -F "$SHARED_DISK_DEV"
  fi

  mkdir -p /shared
  if ! findmnt -M /shared | grep -q "$SHARED_DISK_DEV"; then
    SHARED_UUID=$(blkid -s UUID -o value "$SHARED_DISK_DEV")
    if ! grep -q "UUID=$SHARED_UUID" /etc/fstab; then
      echo "UUID=$SHARED_UUID /shared ext4 defaults,nofail 0 2" >> /etc/fstab
    fi
    systemctl daemon-reload
    mount /shared
  fi
  chmod 777 /shared
  mkdir -p /shared/docker-registry
  chmod 777 /shared/docker-registry

  echo "[SHARED] Installing and configuring nfs-kernel-server..."
  DEBIAN_FRONTEND=noninteractive apt-get update && apt-get install -y nfs-kernel-server
  if ! grep -q "/shared " /etc/exports; then
    echo "/shared ${subnet_cidr}(rw,sync,no_subtree_check,no_root_squash)" >> /etc/exports
  fi
  exportfs -ra
  systemctl enable --now nfs-server.service
  echo "[SHARED] Dedicated /shared disk and NFS server successfully configured!"
fi

cat <<'EOF' > /etc/rancher/rke2/config.yaml
node-name: "${node_name}"
node-ip: "${node_ip}"
cni: cilium
token: "${token}"
tls-san:
  - "${init_node_ip}"
  - "127.0.0.1"
  - "localhost"
EOF

echo "[INIT] Installing RKE2 server binary..."
%{ if rke2_version != "" ~}
curl -sfL https://get.rke2.io | INSTALL_RKE2_VERSION="${rke2_version}" sh -
%{ else ~}
curl -sfL https://get.rke2.io | sh -
%{ endif ~}

echo "[INIT] Enabling and starting rke2-server service..."
systemctl daemon-reload
systemctl enable --now rke2-server.service

echo "[INIT] Waiting for local Kubernetes API server to become ready..."
until /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes 2>/dev/null; do
  echo "Kubernetes API not ready yet, sleeping 5s..."
  sleep 5
done

echo "[INIT] Primary RKE2 control-plane node successfully bootstrapped!"

%{ else ~}
echo "[JOIN] Configuring joining RKE2 server node..."

# Configure NFS client mount for /shared from primary node
echo "[SHARED] Installing nfs-common..."
DEBIAN_FRONTEND=noninteractive apt-get update && apt-get install -y nfs-common
mkdir -p /shared

echo "[SHARED] Waiting for NFS server on ${init_node_ip}:2049..."
for i in {1..60}; do
  if timeout 2 bash -c "cat < /dev/null > /dev/tcp/${init_node_ip}/2049" 2>/dev/null; then
    echo "[SHARED] NFS server reachable on ${init_node_ip}:2049!"
    break
  fi
  sleep 5
done

if ! findmnt -M /shared >/dev/null 2>&1; then
  if ! grep -q "${init_node_ip}:/shared" /etc/fstab; then
    echo "${init_node_ip}:/shared /shared nfs nfsvers=4.2,rw,_netdev,soft,timeo=100 0 0" >> /etc/fstab
  fi
  systemctl daemon-reload
  mount /shared || true
fi

cat <<'EOF' > /etc/rancher/rke2/config.yaml
node-name: "${node_name}"
node-ip: "${node_ip}"
server: "https://${init_node_ip}:9345"
token: "${token}"
cni: cilium
tls-san:
  - "${init_node_ip}"
  - "127.0.0.1"
  - "localhost"
EOF

echo "[JOIN] Waiting for primary node supervisor (https://${init_node_ip}:9345/ping)..."
until curl -k -s -f "https://${init_node_ip}:9345/ping" >/dev/null 2>&1; do
  echo "Supervisor endpoint not reachable yet, waiting 5s..."
  sleep 5
done

echo "[JOIN] Primary node supervisor is healthy. Installing RKE2..."
%{ if rke2_version != "" ~}
curl -sfL https://get.rke2.io | INSTALL_RKE2_VERSION="${rke2_version}" sh -
%{ else ~}
curl -sfL https://get.rke2.io | sh -
%{ endif ~}

echo "[JOIN] Enabling and starting rke2-server service..."
systemctl daemon-reload
systemctl enable --now rke2-server.service

echo "[JOIN] Joining node ${node_name} successfully started and registered!"
%{ endif ~}

# Post-install convenience: export PATH and KUBECONFIG for interactive sessions
mkdir -p /etc/profile.d
cat <<'EOF' > /etc/profile.d/rke2.sh
export PATH="$PATH:/var/lib/rancher/rke2/bin"
export KUBECONFIG="/etc/rancher/rke2/rke2.yaml"
EOF

# Create symlinks for common CLI binaries if available
ln -sf /var/lib/rancher/rke2/bin/kubectl /usr/local/bin/kubectl 2>/dev/null || true
ln -sf /var/lib/rancher/rke2/bin/crictl /usr/local/bin/crictl 2>/dev/null || true

echo "============================================================"
echo "RKE2 bootstrap complete at $(date -u '+%Y-%m-%d %H:%M:%SZ')"
echo "============================================================"
